* text=auto eol=lf

*.png binary
*.pdf binary
*.onnx binary
*.pt binary
*.vsix binary
*.gguf binary
*.npz binary

# Keep snapshot hashes stable across Windows checkouts and Git storage.
shipmblang/_compiler/** -text
shipmblang/_compiler/**/*.py text eol=lf
shipmblang/_compiler/*.py text eol=lf
shipmblang/_compiler/BUNDLED.json text eol=lf
# These five match upstream bytes, including CRLF. compiler.py is mixed.
shipmblang/_compiler/compiler.py -text
shipmblang/_compiler/core.py -text
shipmblang/_compiler/general_runtime.py -text
shipmblang/_compiler/runtime.py -text
shipmblang/_compiler/source_format.py -text

# Vendored vision: LF sources. The llama patch and fixture bytes must survive
# core.autocrlf=true, or git apply and the parity fixture stop matching.
native/shipmb_vision/** text eol=lf
native/shipmb_vision/vendor/** text eol=lf
native/shipmb_vision/patches/** -text
native/shipmb_vision/fixtures/** binary
native/shipmb_vision/**/*.gguf binary
native/shipmb_vision/**/*.npz binary
native/shipmb_vision/**/*.png binary
