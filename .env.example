# ShipMB Lang does not select a model provider by default.
SHIPMB_MODEL_PROVIDER=none

# Optional local OpenAI-compatible provider, including self-hosted gateways.
# SHIPMB_MODEL_PROVIDER=openai_compatible
# SHIPMB_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# SHIPMB_MODEL_NAME=your-local-model
# SHIPMB_MODEL_API_KEY=

# Optional Ollama OpenAI-compatible endpoint.
# SHIPMB_MODEL_PROVIDER=ollama
# SHIPMB_MODEL_NAME=llama3.2