HF_TOKEN=hf_your_token_here
HF_REPO=your-username/driplm-9m-chat
HF_DATASET=your-username/driplm-60k-generic
SHIPMBLANG_HOME=C:/path/to/shipmblang
SHIPMBLANG_PYTHON=C:/path/to/python.exe
SHIPLANG_DEVICE=cpu

# Broader English uses this configured endpoint by default when grammar needs help.
