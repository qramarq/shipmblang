{
  "name": "shipmblang",
  "displayName": "ShipMBLang printurf",
  "description": "Editor-native printurf() for ShipMBLang, the natural language programming layer for ShipMB.",
  "version": "0.1.0",
  "publisher": "shipmb",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/arman-bd/guppylm.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "shiplang",
    "shipmblang",
    "shipmb",
    "printurf",
    "mcp",
    "errors"
  ],
  "scripts": {
    "lint": "node --check src/extension.js",
    "vscode:prepublish": "npm run lint",
    "package": "vsce package"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:shipmblang.explainCurrentDiagnostic",
    "onCommand:shipmblang.explainPastedError",
    "onCommand:shipmblang.explainDiagnostic",
    "onCommand:shipmblang.compileNaturalProgram",
    "onCommand:shipmblang.runNaturalProgram",
    "onCommand:shiplang.explainCurrentDiagnostic",
    "onCommand:shiplang.explainPastedError",
    "onCommand:shiplang.explainDiagnostic",
    "onCommand:shiplang.compileNaturalProgram",
    "onCommand:shiplang.runNaturalProgram",
    "onCommand:drip.explainCurrentDiagnostic",
    "onCommand:drip.explainPastedError",
    "onCommand:drip.explainDiagnostic"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shipmblang.explainCurrentDiagnostic",
        "title": "ShipMBLang: Explain Current Diagnostic"
      },
      {
        "command": "shipmblang.explainPastedError",
        "title": "ShipMBLang: Explain Pasted Error"
      },
      {
        "command": "shipmblang.explainDiagnostic",
        "title": "ShipMBLang: Explain Diagnostic"
      },
      {
        "command": "shipmblang.compileNaturalProgram",
        "title": "ShipMBLang: Compile Natural Program"
      },
      {
        "command": "shipmblang.runNaturalProgram",
        "title": "ShipMBLang: Run Natural Program"
      }
    ],
    "languages": [
      {
        "id": "shipmblang",
        "aliases": [
          "ShipMBLang",
          "ShipLang"
        ],
        "extensions": [
          ".shiplang",
          ".shipmb"
        ]
      }
    ],
    "configuration": {
      "title": "ShipMBLang",
      "properties": {
        "shipmblang.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run ShipMBLang."
        },
        "shipmblang.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the ShipMBLang repo or package root. Leave empty to auto-detect or use an installed package."
        },
        "shipmblang.contextRadius": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "maximum": 40,
          "description": "Number of lines before and after the failing line to send as code context."
        },
        "shipmblang.checkpoint": {
          "type": "string",
          "default": "",
          "description": "Optional local model checkpoint path."
        },
        "shipmblang.tokenizer": {
          "type": "string",
          "default": "",
          "description": "Optional local tokenizer path."
        },
        "shipmblang.device": {
          "type": "string",
          "default": "cpu",
          "description": "Torch device for local inference."
        },
        "shiplang.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Legacy setting. Prefer shipmblang.pythonPath."
        },
        "shiplang.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Legacy setting. Prefer shipmblang.projectRoot."
        },
        "shiplang.contextRadius": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "maximum": 40,
          "description": "Number of lines before and after the failing line to send as code context."
        },
        "shiplang.checkpoint": {
          "type": "string",
          "default": "",
          "description": "Legacy setting. Prefer shipmblang.checkpoint."
        },
        "shiplang.tokenizer": {
          "type": "string",
          "default": "",
          "description": "Legacy setting. Prefer shipmblang.tokenizer."
        },
        "shiplang.device": {
          "type": "string",
          "default": "cpu",
          "description": "Legacy setting. Prefer shipmblang.device."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "shipmblang.explainCurrentDiagnostic",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "shipmblang.explainCurrentDiagnostic"
        },
        {
          "command": "shipmblang.explainPastedError"
        },
        {
          "command": "shipmblang.compileNaturalProgram"
        },
        {
          "command": "shipmblang.runNaturalProgram"
        }
      ]
    }
  }
}
